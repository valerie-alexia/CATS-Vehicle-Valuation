*.tmp
*.bak
*.backup
*.sqlite
*.sqlite3

# ==========================================
# PRIVATE DATA / TRAINING ARTIFACTS
# Temporarily blocked until individually reviewed
# ==========================================
/Data/*
!/Data/audit/
/Data/audit/*
!/Data/audit/v2/
/Data/audit/v2/*
# Reviewed backend runtime only; all other Data contents remain ignored.
!/Data/audit/v2/cats_demo_app.py
!/Data/audit/v2/cats_market_api_experiment.py
!/Data/audit/v2/ev_category_review.py
!/Data/audit/v2/ev_combination_review.py
!/Data/audit/v2/ev_inference_experiment.py
!/Data/audit/v2/market_price_category.py
!/Data/audit/v2/market_price_statistics.py
# Reviewed dynamic helper for the dashboard EV fitting catalog.
!/Data/audit/v2/pipeline_ev_experiment.py
# Reviewed EV inference artifacts; evaluation CSVs remain ignored.
!/Data/audit/v2/ev_specialist_experiment/
/Data/audit/v2/ev_specialist_experiment/*
!/Data/audit/v2/ev_specialist_experiment/ev_experiment_report.json
!/Data/audit/v2/ev_specialist_experiment/ev_training_combinations.json
!/Data/audit/v2/ev_specialist_experiment/ev_fitting_catalog.json
/Experiments/
# Active manifests and exact reviewed bundles only.
/Models/*
!/Models/Mobil123/
/Models/Mobil123/*
!/Models/Mobil123/active.json
!/Models/Mobil123/versions/
/Models/Mobil123/versions/*
!/Models/Mobil123/versions/20261022T093559Z-5eaa62ee/
/Models/Mobil123/versions/20261022T093559Z-5eaa62ee/*
!/Models/Momotor/
/Models/Momotor/*
!/Models/Momotor/active.json
!/Models/Momotor/versions/
/Models/Momotor/versions/*
!/Models/Momotor/versions/20261022T095302Z-b492bfaf/
/Models/Momotor/versions/20261022T095302Z-b492bfaf/*
/src/Scraping/*
!/src/Scraping/scrape_mobil123.py
!/src/Scraping/scrape_momotor.py

# Datasets and model files outside those folders
*.csv
*.xlsx
*.pkl
*.joblib
